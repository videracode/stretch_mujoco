<mujoco model="stretch manipulation table">
  <include file="stretch.xml"/>

  <statistic center="0 -0.5 0.6" extent="1.5" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="-140" elevation="-30"/>
  </visual>

  <asset>
    <material name="floor" rgba=".15 .15 .15 1"/>
    <material name="table" rgba=".55 .4 .28 1"/>
    <material name="bowl" rgba=".85 .85 .85 1"/>
  </asset>

  <default>
    <default class="object">
      <geom friction="2.0 0.02 0.002" condim="4" solref="0.005 1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 -0.6 2.0" dir="0 0 -1" directional="true"/>
    <light pos="1 1 2" dir="-0.4 -0.6 -1" diffuse="0.3 0.3 0.3"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="floor"/>

    <!-- Table: top surface at z = 0.48, near edge at y = -0.5 -->
    <body name="table" pos="0 -0.80 0.24">
      <geom name="table_top" type="box" size="0.6 0.35 0.24" material="table"/>
    </body>

    <!-- Graspable objects (free to move) -->
    <body name="red_cube" pos="-0.25 -0.50 0.501">
      <freejoint/>
      <geom class="object" type="box" size="0.02 0.02 0.02" mass="0.05" rgba="0.85 0.1 0.1 1"/>
    </body>
    <body name="purple_cube" pos="-0.18 -0.56 0.499">
      <freejoint/>
      <geom class="object" type="box" size="0.018 0.018 0.018" mass="0.04" rgba="0.5 0.1 0.7 1"/>
    </body>
    <body name="blue_can" pos="-0.10 -0.52 0.526">
      <freejoint/>
      <geom class="object" type="cylinder" size="0.025 0.045" mass="0.08" rgba="0.1 0.3 0.85 1"/>
    </body>
    <body name="yellow_ball" pos="-0.02 -0.57 0.511">
      <freejoint/>
      <geom class="object" type="sphere" size="0.03" mass="0.05" rgba="0.95 0.85 0.1 1"/>
    </body>
    <body name="green_block" pos="0.05 -0.50 0.516">
      <freejoint/>
      <geom class="object" type="box" size="0.02 0.025 0.035" mass="0.06" rgba="0.1 0.7 0.2 1"/>
    </body>
    <body name="orange_bottle" pos="0.12 -0.55 0.541">
      <freejoint/>
      <geom class="object" type="cylinder" size="0.02 0.06" mass="0.07" rgba="0.95 0.5 0.1 1"/>
    </body>

    <!-- Bowl: fixed to the table, radius 0.08 m, walls 6 cm high -->
    <body name="bowl" pos="0.28 -0.56 0.48">
      <site name="bowl_center" pos="0 0 0.02" size="0.01" rgba="0 1 0 0.3"/>
      <geom name="bowl_base" type="cylinder" size="0.085 0.004" pos="0 0 0.004" material="bowl"/>
      <geom type="box" size="0.004 0.034 0.03" pos="0.08 0 0.034"        euler="0 0 0"      material="bowl"/>
      <geom type="box" size="0.004 0.034 0.03" pos="0.0566 0.0566 0.034"  euler="0 0 0.7854" material="bowl"/>
      <geom type="box" size="0.004 0.034 0.03" pos="0 0.08 0.034"        euler="0 0 1.5708" material="bowl"/>
      <geom type="box" size="0.004 0.034 0.03" pos="-0.0566 0.0566 0.034" euler="0 0 2.3562" material="bowl"/>
      <geom type="box" size="0.004 0.034 0.03" pos="-0.08 0 0.034"       euler="0 0 3.1416" material="bowl"/>
      <geom type="box" size="0.004 0.034 0.03" pos="-0.0566 -0.0566 0.034" euler="0 0 3.9270" material="bowl"/>
      <geom type="box" size="0.004 0.034 0.03" pos="0 -0.08 0.034"       euler="0 0 4.7124" material="bowl"/>
      <geom type="box" size="0.004 0.034 0.03" pos="0.0566 -0.0566 0.034" euler="0 0 5.4978" material="bowl"/>
    </body>
  </worldbody>
</mujoco>